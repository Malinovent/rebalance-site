# Copy to .env.local (gitignored). Never commit real values.
# Public site URL (used for tagged links and canonical URLs). Set once the domain exists.
VITE_SITE_URL=
# Supabase project URL for edge functions (S0.3). Anon key is public by design.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Paddle checkout (public by design): client-side token (test_… or live_…), the early-bird price ID
# (pri_…), and sandbox or live. The Buy button does nothing until the token and price are set.
VITE_PADDLE_CLIENT_TOKEN=
VITE_PADDLE_PRICE_ID=
VITE_PADDLE_ENV=sandbox
